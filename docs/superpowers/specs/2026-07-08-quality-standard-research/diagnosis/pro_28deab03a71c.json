[
 {
  "start": 0.0,
  "end": 4.375,
  "text": "「星球勇士」似乎是一匹前景不俗的年輕賽駒"
 },
 {
  "start": 4.375,
  "end": 6.875,
  "text": "上月率先在田草1000米試閘熟習環境"
 },
 {
  "start": 6.875,
  "end": 9.875,
  "text": "馬兒的表現不俗惟在競跑時東張西望"
 },
 {
  "start": 9.875,
  "end": 13.375,
  "text": "但今場對手都只是3歲和2歲的賽駒馬兒應可一爭"
 },
 {
  "start": 13.375,
  "end": 15.125,
  "text": "「星球勇士」的速度令人留下深刻印象"
 },
 {
  "start": 15.125,
  "end": 18.375,
  "text": "「星球勇士」的速度銳利晨操表現亦理想"
 },
 {
  "start": 18.375,
  "end": 21.375,
  "text": "這匹2歲賽駒現時的成熟程度如何？"
 },
 {
  "start": 21.375,
  "end": 22.875,
  "text": "「星球勇士」年僅2歲"
 },
 {
  "start": 22.875,
  "end": 26.125,
  "text": "但既然對手都是非常年輕的賽駒「星球勇士」與這類對手交鋒"
 },
 {
  "start": 26.125,
  "end": 27.875,
  "text": "爭勝自然容易得多"
 },
 {
  "start": 27.875,
  "end": 32.625,
  "text": "香港的新馬賽事數目較少牠在下季必定會有所進步"
 },
 {
  "start": 32.625,
  "end": 37.375,
  "text": "之後一季轉4歲將會更上一層樓「星球勇士」的潛質豐厚"
 },
 {
  "start": 37.375,
  "end": 39.625,
  "text": "相信你都會滿意「星球勇士」的檔位"
 },
 {
  "start": 39.625,
  "end": 42.625,
  "text": "馬兒可能會貼外欄競跑對初次上陣的賽駒來說可能會有幫助"
 },
 {
  "start": 42.625,
  "end": 44.625,
  "text": "「星球勇士」排6檔"
 },
 {
  "start": 44.625,
  "end": 48.375,
  "text": "只要在出閘時沒有任何瑕疵牠應可以貼外欄競跑"
 },
 {
  "start": 48.375,
  "end": 51.375,
  "text": "馬兒在田草試閘的出閘稍為緩慢"
 },
 {
  "start": 51.375,
  "end": 58.125,
  "text": "我認為牠在這課試閘獲益良多今場的出閘應沒有問題"
 }
]